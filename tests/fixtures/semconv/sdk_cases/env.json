{
  "about": "How an SDK resolves its configuration from RIUS_* environment variables alone (no options passed): resolve_config() in Python, resolveConfig({}, env) in TypeScript. Every RIUS_* variable a case does not name is unset. `expected` names the resolved settings it checks, by the Python field name (the TypeScript SDK maps capture_content to captureContent and so on, and reads heartbeat_interval and partial_spans_delay, in seconds, from its millisecond fields); null means unset. `warns`, when given, says whether the SDK logs a warning while resolving (Python: a WARNING on the rius.config logger; TypeScript: console.warn); when absent, it is not checked. A boolean accepts 1/true/yes/on and 0/false/no/off, trimmed and in any case; anything else, a blank value included, keeps the default with a warning. A blank string setting is unset. A number is read as Python's float() reads it; anything else keeps the default, NaN and the infinities keep it with a warning, and a value outside its range is clamped with a warning.",
  "cases": [
    {
      "name": "blank_capture_content_keeps_the_default",
      "env": {
        "RIUS_CAPTURE_CONTENT": ""
      },
      "expected": {
        "capture_content": true
      },
      "warns": true
    },
    {
      "name": "unrecognised_capture_content_keeps_the_default",
      "env": {
        "RIUS_CAPTURE_CONTENT": "maybe"
      },
      "expected": {
        "capture_content": true
      },
      "warns": true
    },
    {
      "name": "capture_content_false_trimmed_any_case",
      "env": {
        "RIUS_CAPTURE_CONTENT": " FALSE "
      },
      "expected": {
        "capture_content": false
      },
      "warns": false
    },
    {
      "name": "capture_content_0",
      "env": {
        "RIUS_CAPTURE_CONTENT": "0"
      },
      "expected": {
        "capture_content": false
      },
      "warns": false
    },
    {
      "name": "capture_content_no",
      "env": {
        "RIUS_CAPTURE_CONTENT": "no"
      },
      "expected": {
        "capture_content": false
      },
      "warns": false
    },
    {
      "name": "capture_content_off",
      "env": {
        "RIUS_CAPTURE_CONTENT": "off"
      },
      "expected": {
        "capture_content": false
      },
      "warns": false
    },
    {
      "name": "blank_heartbeat_keeps_the_default",
      "env": {
        "RIUS_HEARTBEAT": ""
      },
      "expected": {
        "heartbeat": true
      },
      "warns": true
    },
    {
      "name": "heartbeat_on_any_case",
      "env": {
        "RIUS_HEARTBEAT": "On"
      },
      "expected": {
        "heartbeat": true
      },
      "warns": false
    },
    {
      "name": "heartbeat_false",
      "env": {
        "RIUS_HEARTBEAT": "false"
      },
      "expected": {
        "heartbeat": false
      },
      "warns": false
    },
    {
      "name": "blank_disabled_keeps_the_default",
      "env": {
        "RIUS_DISABLED": ""
      },
      "expected": {
        "disabled": false
      },
      "warns": true
    },
    {
      "name": "disabled_yes",
      "env": {
        "RIUS_DISABLED": "yes"
      },
      "expected": {
        "disabled": true
      },
      "warns": false
    },
    {
      "name": "blank_partial_spans_keeps_the_default",
      "env": {
        "RIUS_PARTIAL_SPANS": " "
      },
      "expected": {
        "partial_spans": false
      },
      "warns": true
    },
    {
      "name": "partial_spans_1",
      "env": {
        "RIUS_PARTIAL_SPANS": "1"
      },
      "expected": {
        "partial_spans": true
      },
      "warns": false
    },
    {
      "name": "bridge_foreign_provider_true",
      "env": {
        "RIUS_BRIDGE_FOREIGN_PROVIDER": "TRUE"
      },
      "expected": {
        "bridge_foreign_provider": true
      },
      "warns": false
    },
    {
      "name": "unrecognised_bridge_foreign_provider_keeps_the_default",
      "env": {
        "RIUS_BRIDGE_FOREIGN_PROVIDER": "2"
      },
      "expected": {
        "bridge_foreign_provider": false
      },
      "warns": true
    },
    {
      "name": "blank_endpoint_is_unset",
      "env": {
        "RIUS_ENDPOINT": ""
      },
      "expected": {
        "endpoint": "https://ingest.eu.console.rius-glassflow.com"
      }
    },
    {
      "name": "blank_service_name_is_unset",
      "env": {
        "RIUS_SERVICE_NAME": ""
      },
      "expected": {
        "service_name": "unknown_service",
        "agent_name": "unknown_service"
      }
    },
    {
      "name": "blank_service_version_is_unset",
      "env": {
        "RIUS_SERVICE_VERSION": ""
      },
      "expected": {
        "service_version": null
      }
    },
    {
      "name": "blank_agent_name_falls_back_to_the_service_name",
      "env": {
        "RIUS_SERVICE_NAME": "svc",
        "RIUS_AGENT_NAME": ""
      },
      "expected": {
        "service_name": "svc",
        "agent_name": "svc"
      }
    },
    {
      "name": "endpoint_and_names_from_the_environment",
      "env": {
        "RIUS_ENDPOINT": "https://e.example",
        "RIUS_SERVICE_NAME": "svc",
        "RIUS_AGENT_NAME": "planner",
        "RIUS_SERVICE_VERSION": "1.2.3"
      },
      "expected": {
        "endpoint": "https://e.example",
        "service_name": "svc",
        "agent_name": "planner",
        "service_version": "1.2.3"
      }
    },
    {
      "name": "sample_rate_padded",
      "env": {
        "RIUS_SAMPLE_RATE": " 0.5 "
      },
      "expected": {
        "sample_rate": 0.5
      },
      "warns": false
    },
    {
      "name": "sample_rate_leading_dot",
      "env": {
        "RIUS_SAMPLE_RATE": ".25"
      },
      "expected": {
        "sample_rate": 0.25
      },
      "warns": false
    },
    {
      "name": "sample_rate_exponent",
      "env": {
        "RIUS_SAMPLE_RATE": "5e-1"
      },
      "expected": {
        "sample_rate": 0.5
      },
      "warns": false
    },
    {
      "name": "heartbeat_interval_signed_trailing_dot",
      "env": {
        "RIUS_HEARTBEAT_INTERVAL": "+20."
      },
      "expected": {
        "heartbeat_interval": 20
      },
      "warns": false
    },
    {
      "name": "partial_spans_delay_integer",
      "env": {
        "RIUS_PARTIAL_SPANS_DELAY": "3"
      },
      "expected": {
        "partial_spans_delay": 3
      },
      "warns": false
    },
    {
      "name": "sample_rate_with_trailing_text_is_rejected",
      "env": {
        "RIUS_SAMPLE_RATE": "0.5abc"
      },
      "expected": {
        "sample_rate": 1
      }
    },
    {
      "name": "blank_sample_rate_is_rejected",
      "env": {
        "RIUS_SAMPLE_RATE": ""
      },
      "expected": {
        "sample_rate": 1
      }
    },
    {
      "name": "hex_sample_rate_is_rejected",
      "env": {
        "RIUS_SAMPLE_RATE": "0x1"
      },
      "expected": {
        "sample_rate": 1
      }
    },
    {
      "name": "heartbeat_interval_with_a_unit_is_rejected",
      "env": {
        "RIUS_HEARTBEAT_INTERVAL": "10s"
      },
      "expected": {
        "heartbeat_interval": 15
      }
    },
    {
      "name": "partial_spans_delay_in_words_is_rejected",
      "env": {
        "RIUS_PARTIAL_SPANS_DELAY": "5 seconds"
      },
      "expected": {
        "partial_spans_delay": 0
      }
    },
    {
      "name": "nan_sample_rate_is_the_default",
      "env": {
        "RIUS_SAMPLE_RATE": "nan"
      },
      "expected": {
        "sample_rate": 1
      },
      "warns": true
    },
    {
      "name": "infinite_heartbeat_interval_is_the_default",
      "env": {
        "RIUS_HEARTBEAT_INTERVAL": "inf"
      },
      "expected": {
        "heartbeat_interval": 15
      },
      "warns": true
    },
    {
      "name": "sample_rate_above_one_is_clamped",
      "env": {
        "RIUS_SAMPLE_RATE": "5"
      },
      "expected": {
        "sample_rate": 1
      },
      "warns": true
    },
    {
      "name": "sample_rate_below_zero_is_clamped",
      "env": {
        "RIUS_SAMPLE_RATE": "-1"
      },
      "expected": {
        "sample_rate": 0
      },
      "warns": true
    },
    {
      "name": "heartbeat_interval_below_the_minimum_is_clamped",
      "env": {
        "RIUS_HEARTBEAT_INTERVAL": "1"
      },
      "expected": {
        "heartbeat_interval": 5
      },
      "warns": true
    },
    {
      "name": "heartbeat_interval_above_the_maximum_is_clamped",
      "env": {
        "RIUS_HEARTBEAT_INTERVAL": "1000"
      },
      "expected": {
        "heartbeat_interval": 300
      },
      "warns": true
    },
    {
      "name": "partial_spans_delay_above_the_maximum_is_clamped",
      "env": {
        "RIUS_PARTIAL_SPANS_DELAY": "100"
      },
      "expected": {
        "partial_spans_delay": 60
      },
      "warns": true
    },
    {
      "name": "unset_is_every_default",
      "env": {},
      "expected": {
        "endpoint": "https://ingest.eu.console.rius-glassflow.com",
        "service_name": "unknown_service",
        "agent_name": "unknown_service",
        "service_version": null,
        "disabled": false,
        "capture_content": true,
        "heartbeat": true,
        "partial_spans": false,
        "bridge_foreign_provider": false,
        "sample_rate": 1,
        "heartbeat_interval": 15,
        "partial_spans_delay": 0
      },
      "warns": false
    }
  ]
}
