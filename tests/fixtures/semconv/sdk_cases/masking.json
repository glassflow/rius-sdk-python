{
  "about": "What an SDK's masking exporter (MaskingSpanExporter, between the span processors and the OTLP exporter) does to a span's content: its content attributes (registry content keys, e.g. input.value, gen_ai.input.messages), the exception.message and exception.stacktrace of an exception event, and the status description. Non-content attributes, exception.type and the status code always survive. `capture_content` false drops all content whatever the mask. With it true, `mask` (when given) runs over each content value with its key (status.description for the status): `returns` gives that value back, `format` gives the string with {key} and {value} filled in, `throws` raises. A mask that returns null or throws drops the value; a string, number or boolean it returns is kept as it is. `span` is the span as it ends (an ERROR status with `status` as its description when given); `expected` is what reaches the inner exporter: every attribute, the status description (null for none), and every event's attributes. `scope`, when given, is the instrumentation scope name of the span (another name otherwise). On a span whose scope starts with com.anthropic.sdk. (the Anthropic SDK's own spans), url.query and url.full are content too, as that SDK's content mode leaves query parameters it treats as content in them: `capture_content` false drops url.query and leaves url.full without its query and fragment, and a mask runs over both like any other content value. On any other scope they are not content.",
  "cases": [
    {
      "name": "capture_on_without_a_mask_keeps_everything",
      "capture_content": true,
      "mask": null,
      "span": {
        "attributes": {
          "input.value": "secret",
          "gen_ai.request.model": "m"
        },
        "events": [
          {
            "name": "exception",
            "attributes": {
              "exception.type": "ValueError",
              "exception.message": "secret",
              "exception.stacktrace": "trace"
            }
          }
        ],
        "status": "secret"
      },
      "expected": {
        "attributes": {
          "input.value": "secret",
          "gen_ai.request.model": "m"
        },
        "events": [
          {
            "name": "exception",
            "attributes": {
              "exception.type": "ValueError",
              "exception.message": "secret",
              "exception.stacktrace": "trace"
            }
          }
        ],
        "status": "secret"
      }
    },
    {
      "name": "capture_off_drops_content_attributes_exception_text_and_status",
      "capture_content": false,
      "mask": null,
      "span": {
        "attributes": {
          "input.value": "secret",
          "output.value": "secret",
          "gen_ai.input.messages": "[]",
          "gen_ai.request.model": "m"
        },
        "events": [
          {
            "name": "exception",
            "attributes": {
              "exception.type": "ValueError",
              "exception.message": "secret",
              "exception.stacktrace": "trace"
            }
          }
        ],
        "status": "secret"
      },
      "expected": {
        "attributes": {
          "gen_ai.request.model": "m"
        },
        "events": [
          {
            "name": "exception",
            "attributes": {
              "exception.type": "ValueError"
            }
          }
        ],
        "status": null
      }
    },
    {
      "name": "capture_off_drops_the_anthropic_sdk_tool_run_content",
      "capture_content": false,
      "mask": null,
      "span": {
        "attributes": {
          "gen_ai.operation.name": "execute_tool",
          "gen_ai.tool.name": "get_weather",
          "gen_ai.tool.description": "Look up the weather",
          "gen_ai.tool.call.id": "toolu_1",
          "gen_ai.tool.call.arguments": "{\"city\":\"Paris\"}",
          "anthropic.tool_result.content": "[{\"type\":\"text\",\"text\":\"sunny, 22C\"}]"
        },
        "events": []
      },
      "expected": {
        "attributes": {
          "gen_ai.operation.name": "execute_tool",
          "gen_ai.tool.name": "get_weather",
          "gen_ai.tool.call.id": "toolu_1"
        },
        "events": [],
        "status": null
      }
    },
