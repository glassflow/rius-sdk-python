      "expected": {
        "gen_ai.input.messages": "plain text, not JSON"
      }
    },
    {
      "name": "scalar_value_kept",
      "attributes": {
        "gen_ai.input.messages": 3
      },
      "expected": {
        "gen_ai.input.messages": 3
      }
    }
  ]
}
